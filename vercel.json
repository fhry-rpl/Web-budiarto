{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "memory": 1024,
            "maxDuration": 60
        }
    },
    "routes": [
        { "src": "/build/(.*)", "dest": "/public/build/$1" },
        { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
        { "src": "/favicon.png", "dest": "/public/favicon.ico" },
        { "src": "/robots.txt", "dest": "/public/robots.txt" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_KEY": "base64:EL1zsCtqwmyIu2uANb2aHppcqYdeYYPaEyMtWcGbDc4=",
        "APP_URL": "https://web-budiarto.vercel.app",
        "NODE_ENV": "production",
        "DB_CONNECTION": "pgsql",
        "SESSION_DRIVER": "cookie",
        "SESSION_SECURE_COOKIE": "true",
        "CACHE_STORE": "array",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "error",
        "FILESYSTEM_DISK": "s3",
        "UPLOADS_DISK": "s3",
        "AWS_SECRET_ACCESS_KEY": "",
        "AWS_DEFAULT_REGION": "auto",
        "AWS_BUCKET": "",
        "AWS_ENDPOINT": "https://k0x3mch1pfuksbtw.private.blob.vercel-storage.com",
        "AWS_URL": "https://k0x3mch1pfuksbtw.private.blob.vercel-storage.com",
        "COMPOSER_PROCESS_TIMEOUT": "0",
        "COMPOSER_ALLOW_SUPERUSER": "1"
    }
}
